<%- include('../partials/header', { title: 'จัดการคำขอห้องลอง — crwn.st' }) %>
<%- include('../partials/navbar', { user, backUrl: '/staff' }) %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <span class="text-xs uppercase tracking-widest text-[#A3907C] font-semibold">Fitting Room Management</span>
      <h1 class="font-serif text-2xl sm:text-3xl font-bold text-[#1F2421]">คำขอเปลี่ยนเสื้อผ้า (Fitting Orders)</h1>
      <p class="text-xs text-[#8A8177] mt-0.5">จัดการคำขอขอลองไซส์และสีของลูกค้าในห้องลองแบบเรียลไทม์</p>
    </div>
    
    <div class="flex items-center gap-3">
      <button onclick="loadFittingOrders()" class="btn-secondary text-xs py-2 px-3.5 flex items-center gap-1.5">
        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
        <span>รีเฟรช</span>
      </button>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/70 border border-[#A3907C]/20 text-xs text-[#1F2421]">
        <span class="w-2 h-2 rounded-full bg-[#9BAF9F] animate-pulse"></span>
        <span>ซิงก์อัตโนมัติ</span>
      </span>
    </div>
  </div>

  <!-- Kanban Columns Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    
    <!-- Col 1: Pending -->
    <div class="glass-heavy rounded-2xl p-4 border border-amber-200/50 shadow-xs flex flex-col">
      <div class="flex items-center justify-between pb-3 border-b border-amber-200/60 mb-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          <h3 class="font-medium text-sm text-[#1F2421]">รอดำเนินการ (Pending)</h3>
        </div>
        <span id="count-pending" class="text-xs font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-900">0</span>
      </div>
      <div id="col-pending" class="space-y-3 flex-1 min-h-[300px]"></div>
    </div>

    <!-- Col 2: Preparing -->
    <div class="glass-heavy rounded-2xl p-4 border border-blue-200/50 shadow-xs flex flex-col">
      <div class="flex items-center justify-between pb-3 border-b border-blue-200/60 mb-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></span>
          <h3 class="font-medium text-sm text-[#1F2421]">กำลังจัดเตรียม (Preparing)</h3>
        </div>
        <span id="count-preparing" class="text-xs font-bold px-2 py-0.5 rounded-full bg-blue-100 text-blue-900">0</span>
      </div>
      <div id="col-preparing" class="space-y-3 flex-1 min-h-[300px]"></div>
    </div>

    <!-- Col 3: Complete -->
    <div class="glass-heavy rounded-2xl p-4 border border-green-200/50 shadow-xs flex flex-col">
      <div class="flex items-center justify-between pb-3 border-b border-green-200/60 mb-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
          <h3 class="font-medium text-sm text-[#1F2421]">นำส่งแล้ว (Complete)</h3>
        </div>
        <span id="count-complete" class="text-xs font-bold px-2 py-0.5 rounded-full bg-green-100 text-green-900">0</span>
      </div>
      <div id="col-complete" class="space-y-3 flex-1 min-h-[300px]"></div>
    </div>

  </div>

</main>

<script>
  async function loadFittingOrders() {
    try {
      const res = await fetch('/api/fitting-orders');
      if (!res.ok) return;
      const orders = await res.json();
      renderKanban(orders);
    } catch (e) {
      console.warn(e);
    }
  }

  function renderKanban(orders) {
    const colPending = document.getElementById('col-pending');
    const colPreparing = document.getElementById('col-preparing');
    const colComplete = document.getElementById('col-complete');

    const pending = orders.filter(o => o.status === 'pending');
    const preparing = orders.filter(o => o.status === 'preparing');
    const complete = orders.filter(o => o.status === 'complete');

    document.getElementById('count-pending').textContent = pending.length;
    document.getElementById('count-preparing').textContent = preparing.length;
    document.getElementById('count-complete').textContent = complete.length;

    colPending.innerHTML = pending.length === 0 
      ? '<p class="text-center text-xs text-[#8A8177] py-8">ไม่มีรายการค้าง</p>'
      : pending.map(o => createOrderCard(o, 'pending')).join('');

    colPreparing.innerHTML = preparing.length === 0
      ? '<p class="text-center text-xs text-[#8A8177] py-8">ไม่มีรายการกำลังเตรียม</p>'
      : preparing.map(o => createOrderCard(o, 'preparing')).join('');

    colComplete.innerHTML = complete.length === 0
      ? '<p class="text-center text-xs text-[#8A8177] py-8">ไม่มีรายการที่เพิ่งส่ง</p>'
      : complete.map(o => createOrderCard(o, 'complete')).join('');

    if (window.lucide) window.lucide.createIcons();
  }

  function createOrderCard(o, status) {
    const timeStr = new Date(o.createdAt || Date.now()).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
    
    let actionBtn = '';
    if (status === 'pending') {
      actionBtn = `
        <button onclick="updateOrderStatus('${o.id}', 'preparing')" class="w-full btn-primary text-xs py-2 shadow-xs">
          <i data-lucide="play" class="w-3.5 h-3.5"></i> รับงานจัดเตรียม
        </button>
      `;
    } else if (status === 'preparing') {
      actionBtn = `
        <button onclick="updateOrderStatus('${o.id}', 'complete')" class="w-full py-2 px-3 rounded-xl bg-[#9BAF9F] hover:bg-[#8AA08E] text-[#1F2421] text-xs font-semibold flex items-center justify-center gap-1.5 transition shadow-xs">
          <i data-lucide="check" class="w-3.5 h-3.5"></i> นำส่งหน้าห้องลองแล้ว
        </button>
      `;
    }

    return `
      <div class="p-4 rounded-2xl bg-white border border-[#A3907C]/20 shadow-xs space-y-3">
        <div class="flex items-center justify-between">
          <span class="px-2.5 py-1 rounded-lg bg-[#1F2421] text-[#F5F2EB] font-serif font-bold text-xs">
            ห้อง ${o.roomId || '1'}
          </span>
          <span class="text-[11px] text-[#8A8177] font-mono">${timeStr}</span>
        </div>

        <div>
          <h4 class="font-medium text-sm text-[#1F2421] leading-snug">${o.productName || 'เสื้อผ้า'}</h4>
          <div class="flex items-center gap-2 mt-1.5 text-xs text-[#6B635A]">
            <span class="px-2 py-0.5 rounded bg-[#F5F2EB] font-semibold text-[#1F2421]">ไซส์: ${o.size || '-'}</span>
            <span class="px-2 py-0.5 rounded bg-[#F5F2EB] font-semibold text-[#1F2421]">สี: ${o.color || '-'}</span>
          </div>
          <p class="text-[10px] text-[#8A8177] font-mono mt-1">SKU: ${o.sku}</p>
        </div>

        ${actionBtn}
      </div>
    `;
  }

  async function updateOrderStatus(id, status) {
    try {
      const res = await fetch(`/api/fitting-orders/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      if (res.ok) {
        loadFittingOrders();
      } else {
        alert('เกิดข้อผิดพลาดในการปรับสถานะ');
      }
    } catch (e) {
      alert(e.message);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadFittingOrders();
    setInterval(loadFittingOrders, 4000);
  });
</script>

<%- include('../partials/footer') %>
