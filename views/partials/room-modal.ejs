<!-- Room Scanner Modal (Scan QR to Enter Only) -->
<div id="room-modal" class="fixed inset-0 bg-[#1F2421]/50 backdrop-blur-xs z-[80] flex items-center justify-center p-4 hidden touch-none overscroll-none">
  <div class="w-full max-w-md bg-[#FAF8F5] rounded-3xl p-6 sm:p-7 shadow-2xl border border-[#A3907C]/25 relative animate-fade-in max-h-[90vh] overflow-y-auto overscroll-contain">
    
    <!-- Close button -->
    <button type="button" onclick="closeRoomModal()" class="absolute top-5 right-5 p-2 rounded-full hover:bg-black/5 text-[#8A8177] hover:text-[#1F2421] transition cursor-pointer" title="ปิดหน้าต่าง">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>

    <!-- Header -->
    <div class="text-center mb-5">
      <div class="w-13 h-13 rounded-2xl bg-[#E8DFD1]/70 mx-auto flex items-center justify-center text-[#1F2421] mb-2.5 shadow-xs">
        <i data-lucide="qr-code" class="w-6 h-6"></i>
      </div>
      <h3 class="font-serif text-2xl font-semibold text-[#1F2421]">สแกน QR Code เข้าห้องลอง</h3>
      <p class="text-xs text-[#8A8177] mt-1">เข้าใช้งานห้องลองเสื้อได้โดยการสแกน QR Code ที่ติดอยู่หน้าห้องเท่านั้น</p>
    </div>

    <!-- Error notice container (if room is occupied or invalid) -->
    <div id="room-modal-error" class="hidden mb-4 p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-start gap-2.5 animate-fade-in shadow-xs">
      <i data-lucide="lock" class="w-4 h-4 flex-shrink-0 text-rose-600 mt-0.5"></i>
      <span id="room-modal-error-text" class="flex-1 font-medium">ห้องลองนี้กำลังมีผู้ใช้งานอยู่ ไม่สามารถเข้าได้</span>
    </div>

    <!-- QR SCANNER SECTION -->
    <div class="space-y-4">
      <p class="text-[11px] text-[#8A8177] text-center">ส่องกล้องไปที่ป้าย QR Code ติดหน้าประตูห้องลองเพื่อปลดล็อกและเริ่มลองชุด</p>

      <!-- Camera Viewfinder -->
      <div class="relative w-full aspect-4/3 rounded-2xl bg-[#1F2421] overflow-hidden flex flex-col items-center justify-center border border-white/20 shadow-inner">
        <!-- Video stream -->
        <video id="room-qr-video" class="absolute inset-0 w-full h-full object-cover hidden" playsinline autoplay muted></video>

        <!-- Camera off placeholder -->
        <div id="room-qr-off-state" class="text-center p-4 z-10 flex flex-col items-center">
          <div class="w-12 h-12 rounded-2xl bg-white/10 text-[#F5F2EB] flex items-center justify-center mb-2 shadow-inner">
            <i data-lucide="qr-code" class="w-6 h-6"></i>
          </div>
          <p class="text-xs font-medium text-[#F5F2EB]">กล้องยังไม่ได้เปิด</p>
          <p class="text-[10px] text-[#F5F2EB]/60 mt-0.5">กดปุ่มด้านล่างเพื่อเปิดกล้องสแกน QR Code หน้าห้อง</p>
        </div>

        <!-- Laser beam scan effect -->
        <div id="room-qr-beam" class="absolute w-full h-0.5 bg-gradient-to-r from-transparent via-[#C9A598] to-transparent scan-beam shadow-[0_0_10px_#C9A598] hidden z-20"></div>

        <!-- QR Reticle Frame -->
        <div class="absolute inset-8 border-2 border-dashed border-[#C9A598]/60 rounded-xl pointer-events-none flex items-center justify-center z-20">
          <span class="text-[9px] text-[#F5F2EB]/60 uppercase tracking-widest bg-black/40 px-2 py-0.5 rounded">จัดวาง QR ในกรอบ</span>
        </div>
      </div>

      <!-- Camera toggle button -->
      <button type="button" id="btn-toggle-room-camera" onclick="toggleRoomQrCamera()" class="w-full btn-primary py-3 text-xs flex items-center justify-center gap-2 shadow-xs cursor-pointer">
        <i data-lucide="camera" class="w-4 h-4"></i>
        <span id="btn-room-camera-label">เปิดกล้องสแกน QR Code</span>
      </button>

      <!-- Simulation Buttons for testing QR codes -->
      <div class="pt-3 border-t border-[#A3907C]/15">
        <span class="text-[10px] font-bold text-[#8A8177] uppercase tracking-wider block mb-1.5 text-center">จำลองการสแกน QR Code หน้าห้อง (สำหรับทดสอบ):</span>
        <div class="grid grid-cols-3 gap-1.5 text-xs">
          <button type="button" onclick="simulateRoomQrScan('1')" class="py-2.5 px-1 rounded-xl bg-white border border-[#A3907C]/30 hover:border-[#1F2421] text-[#1F2421] text-center font-medium transition shadow-2xs hover:bg-[#F5F2EB] active:scale-95 cursor-pointer">
            <span class="block text-[10px] text-[#8A8177]">สแกน QR</span>
            <span class="font-bold text-xs">ห้อง 01</span>
            <span class="block text-[9px] text-emerald-700 font-semibold">ห้องว่าง</span>
          </button>
          <button type="button" onclick="simulateRoomQrScan('2')" class="py-2.5 px-1 rounded-xl bg-rose-50 border border-rose-200 hover:border-rose-400 text-rose-900 text-center font-medium transition shadow-2xs hover:bg-rose-100/70 active:scale-95 cursor-pointer">
            <span class="block text-[10px] text-rose-700">สแกน QR</span>
            <span class="font-bold text-xs">ห้อง 02</span>
            <span class="block text-[9px] text-rose-700 font-semibold">ล็อก/มีคนใช้</span>
          </button>
          <button type="button" onclick="simulateRoomQrScan('3')" class="py-2.5 px-1 rounded-xl bg-white border border-[#A3907C]/30 hover:border-[#1F2421] text-[#1F2421] text-center font-medium transition shadow-2xs hover:bg-[#F5F2EB] active:scale-95 cursor-pointer">
            <span class="block text-[10px] text-[#8A8177]">สแกน QR</span>
            <span class="font-bold text-xs">ห้อง 03</span>
            <span class="block text-[9px] text-emerald-700 font-semibold">ห้องว่าง</span>
          </button>
        </div>
        <p class="text-[10px] text-center text-[#8A8177] mt-2">หมายเหตุ: ระบบจะไม่อนุญาตให้เข้าห้องที่ล็อกอยู่หรือกำลังมีผู้ใช้งาน</p>
      </div>
    </div>

  </div>
</div>
