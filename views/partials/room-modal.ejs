<!-- Room Scanner / Selection Modal -->
<div id="room-modal" class="fixed inset-0 bg-[#1F2421]/40 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="w-full max-w-md glass-heavy rounded-3xl p-6 sm:p-7 shadow-2xl border border-white/60 relative animate-fade-in max-h-[90vh] overflow-y-auto">
    
    <!-- Close button -->
    <button type="button" onclick="closeRoomModal()" class="absolute top-5 right-5 p-2 rounded-full hover:bg-white/80 text-[#8A8177] hover:text-[#1F2421] transition" title="ปิดหน้าต่าง">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>

    <!-- Header -->
    <div class="text-center mb-5">
      <div class="w-13 h-13 rounded-2xl bg-[#E8DFD1]/70 mx-auto flex items-center justify-center text-[#1F2421] mb-2.5 shadow-xs">
        <i data-lucide="door-open" class="w-6 h-6"></i>
      </div>
      <h3 class="font-serif text-2xl font-semibold text-[#1F2421]">เข้าห้องลองเสื้อ</h3>
      <p class="text-xs text-[#8A8177] mt-0.5">เลือกห้องลองที่ว่าง หรือสแกน QR Code ติดหน้าประตูห้อง</p>
    </div>

    <!-- Mode Tabs: เลือกห้อง vs สแกน QR -->
    <div class="flex p-1 rounded-2xl bg-[#E8DFD1]/60 mb-5">
      <button type="button" id="tab-room-select" onclick="switchRoomModalTab('select')" class="flex-1 py-2 rounded-xl text-xs font-semibold transition-all bg-[#1F2421] text-[#F5F2EB] shadow-xs flex items-center justify-center gap-1.5">
        <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
        <span>เลือกห้อง / กรอกเลข</span>
      </button>
      <button type="button" id="tab-room-qr" onclick="switchRoomModalTab('qr')" class="flex-1 py-2 rounded-xl text-xs font-semibold transition-all text-[#8A8177] hover:text-[#1F2421] flex items-center justify-center gap-1.5">
        <i data-lucide="qr-code" class="w-3.5 h-3.5"></i>
        <span>สแกน QR หน้าห้อง</span>
      </button>
    </div>

    <!-- Error notice container (if room is occupied or invalid) -->
    <div id="room-modal-error" class="hidden mb-4 p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-start gap-2.5 animate-fade-in shadow-xs">
      <i data-lucide="lock" class="w-4 h-4 flex-shrink-0 text-rose-600 mt-0.5"></i>
      <span id="room-modal-error-text" class="flex-1 font-medium">ห้องลองนี้กำลังมีผู้ใช้งานอยู่ ไม่สามารถเข้าได้</span>
    </div>

    <!-- TAB 1: ROOM GRID & MANUAL INPUT -->
    <div id="section-room-select" class="space-y-4">
      <div class="flex items-center justify-between">
        <p class="text-[11px] font-semibold text-[#8A8177] uppercase tracking-wider">สถานะห้องลอง (คลิกห้องที่ว่างเพื่อเข้า)</p>
        <button type="button" onclick="loadRoomModalStatus()" class="text-[11px] text-[#A3907C] hover:text-[#1F2421] flex items-center gap-1">
          <i data-lucide="refresh-cw" class="w-3 h-3"></i>
          <span>รีเฟรช</span>
        </button>
      </div>
      
      <div id="rooms-grid-container" class="grid grid-cols-3 gap-3">
        <!-- Dynamic room cards loaded by JS -->
        <div class="col-span-3 py-6 text-center text-xs text-[#8A8177]">
          กำลังตรวจสอบสถานะห้องลอง...
        </div>
      </div>

      <!-- Manual Code Input -->
      <div class="pt-3 border-t border-[#A3907C]/15">
        <label for="manual-room-input" class="block text-[11px] font-semibold text-[#8A8177] uppercase tracking-wider mb-1.5">หรือกรอกหมายเลขห้องลอง</label>
        <div class="flex gap-2">
          <input type="text" id="manual-room-input" placeholder="พิมพ์เลข 1, 2, หรือ 3" class="flex-1 px-3.5 py-2.5 rounded-xl bg-white border border-[#A3907C]/30 text-xs font-mono focus:outline-none focus:border-[#1F2421]" onkeypress="if(event.key==='Enter') submitManualRoom()">
          <button type="button" onclick="submitManualRoom()" id="btn-manual-enter-room" class="btn-primary text-xs px-4 py-2.5">
            เข้าสู่ห้อง
          </button>
        </div>
        <p class="text-[10px] text-[#8A8177] mt-1">หากห้องถูกล็อกอยู่ ระบบจะป้องกันไม่ให้เข้าใช้งาน</p>
      </div>
    </div>

    <!-- TAB 2: QR SCANNER SECTION -->
    <div id="section-room-qr" class="space-y-3.5 hidden">
      <p class="text-[11px] text-[#8A8177] text-center">ส่องกล้องไปที่ป้าย QR Code ที่ติดอยู่หน้าห้องลองเพื่อเข้าห้องอัตโนมัติ</p>

      <!-- Camera Viewfinder -->
      <div class="relative w-full aspect-4/3 rounded-2xl bg-[#1F2421] overflow-hidden flex flex-col items-center justify-center border border-white/20 shadow-inner">
        <!-- Video stream -->
        <video id="room-qr-video" class="absolute inset-0 w-full h-full object-cover hidden" playsinline autoplay muted></video>

        <!-- Camera off placeholder -->
        <div id="room-qr-off-state" class="text-center p-4 z-10 flex flex-col items-center">
          <div class="w-12 h-12 rounded-2xl bg-white/10 text-[#F5F2EB] flex items-center justify-center mb-2 shadow-inner">
            <i data-lucide="qr-code" class="w-6 h-6"></i>
          </div>
          <p class="text-xs font-medium text-[#F5F2EB]">กล้องยังไม่ได้เปิด</p>
          <p class="text-[10px] text-[#F5F2EB]/60 mt-0.5">กดปุ่มด้านล่างเพื่อเปิดกล้องสแกน QR Code หน้าห้อง</p>
        </div>

        <!-- Laser beam scan effect -->
        <div id="room-qr-beam" class="absolute w-full h-0.5 bg-gradient-to-r from-transparent via-[#C9A598] to-transparent scan-beam shadow-[0_0_10px_#C9A598] hidden z-20"></div>

        <!-- QR Reticle Frame -->
        <div class="absolute inset-8 border-2 border-dashed border-[#C9A598]/60 rounded-xl pointer-events-none flex items-center justify-center z-20">
          <span class="text-[9px] text-[#F5F2EB]/60 uppercase tracking-widest bg-black/40 px-2 py-0.5 rounded">จัดวาง QR ในกรอบ</span>
        </div>
      </div>

      <!-- Camera toggle button -->
      <button type="button" id="btn-toggle-room-camera" onclick="toggleRoomQrCamera()" class="w-full btn-primary py-2.5 text-xs flex items-center justify-center gap-2 shadow-xs">
        <i data-lucide="camera" class="w-4 h-4"></i>
        <span id="btn-room-camera-label">เปิดกล้องสแกน QR Code</span>
      </button>

      <!-- Simulation Buttons for testing QR codes -->
      <div class="pt-2.5 border-t border-[#A3907C]/15">
        <span class="text-[10px] font-bold text-[#8A8177] uppercase tracking-wider block mb-1.5">จำลองการสแกน QR Code (คลิกเพื่อทดสอบ):</span>
        <div class="grid grid-cols-3 gap-1.5 text-xs">
          <button type="button" onclick="simulateRoomQrScan('1')" class="py-2 px-1 rounded-xl bg-white/80 border border-[#A3907C]/30 hover:border-[#1F2421] text-[#1F2421] text-center font-medium transition shadow-2xs hover:bg-white">
            <span class="block text-[10px] text-[#8A8177]">QR หน้าห้อง</span>
            <span class="font-bold text-xs">ห้อง 01</span>
            <span class="block text-[9px] text-emerald-700 font-semibold">ว่าง</span>
          </button>
          <button type="button" onclick="simulateRoomQrScan('2')" class="py-2 px-1 rounded-xl bg-rose-50/60 border border-rose-200 hover:border-rose-400 text-rose-900 text-center font-medium transition shadow-2xs">
            <span class="block text-[10px] text-rose-700">QR หน้าห้อง</span>
            <span class="font-bold text-xs">ห้อง 02</span>
            <span class="block text-[9px] text-rose-700 font-semibold">ล็อก/มีคนใช้</span>
          </button>
          <button type="button" onclick="simulateRoomQrScan('3')" class="py-2 px-1 rounded-xl bg-white/80 border border-[#A3907C]/30 hover:border-[#1F2421] text-[#1F2421] text-center font-medium transition shadow-2xs hover:bg-white">
            <span class="block text-[10px] text-[#8A8177]">QR หน้าห้อง</span>
            <span class="font-bold text-xs">ห้อง 03</span>
            <span class="block text-[9px] text-emerald-700 font-semibold">ว่าง</span>
          </button>
        </div>
      </div>
    </div>

  </div>
</div>
