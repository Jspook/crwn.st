<%- include('../partials/header', { title: 'ห้องลองเสื้อ ห้อง ' + (typeof roomDisplay !== 'undefined' ? roomDisplay : roomId) + ' — crwn.st' }) %>
<%- include('../partials/navbar', { user, backAction: 'confirmExitFittingRoom()', showCart: true }) %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-4 sm:py-6 pb-28">

  <!-- Active Room Status Banner -->
  <div class="glass-heavy rounded-3xl p-4 sm:p-6 mb-6 border border-white/80 shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-[#1F2421] text-[#F5F2EB] flex items-center justify-center font-serif text-xl font-bold shadow-xs flex-shrink-0">
        <%= typeof roomDisplay !== 'undefined' ? roomDisplay : roomId %>
      </div>
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-[#1F2421]">ห้องลองเสื้อ <%= typeof roomDisplay !== 'undefined' ? roomDisplay : roomId %></h1>
      </div>
    </div>

    <!-- Right Header Action: Exit Button -->
    <div class="flex items-center gap-2">
      <button onclick="confirmExitFittingRoom()" class="btn-secondary text-xs py-2 px-4 flex items-center gap-1.5 shadow-2xs cursor-pointer">
        <i data-lucide="log-out" class="w-4 h-4"></i>
        <span>ออกจากห้องลอง</span>
      </button>
    </div>
  </div>

  <!-- Note banner: Only order 1 item at a time to try -->
  <div class="mb-6 p-3.5 rounded-2xl bg-[#F5F2EB] border border-[#A3907C]/25 text-xs text-[#6B635A] flex items-center gap-2.5 shadow-2xs">
    <i data-lucide="info" class="w-4 h-4 text-[#A3907C] flex-shrink-0"></i>
    <span>ในห้องลองเสื้อ กรุณาสั่งสินค้ามาลองทีละตัว เมื่อลองเสร็จแล้วสามารถเลือกนำใส่ตะกร้าก่อนออกจากห้องลองได้</span>
  </div>

  <!-- Search & Category Filters -->
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-6">
    
    <!-- Category Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0 scrollbar-none" id="category-filter-list">
      <button onclick="filterCategory('ALL')" class="category-btn px-4 py-2 rounded-full text-xs font-medium transition bg-[#1F2421] text-[#F5F2EB] shadow-xs flex-shrink-0" data-category="ALL">
        ทั้งหมด
      </button>
      <% 
        const categories = [...new Set(products.map(p => p.ITM_Category).filter(Boolean))];
        categories.forEach(function(cat) { 
      %>
        <button onclick="filterCategory('<%= cat %>')" class="category-btn px-4 py-2 rounded-full text-xs font-medium transition bg-white/70 text-[#1F2421] hover:bg-white border border-[#A3907C]/20 flex-shrink-0" data-category="<%= cat %>">
          <%= cat %>
        </button>
      <% }); %>
    </div>

    <!-- Quick Search Input (Debounced) -->
    <div class="relative w-full sm:w-64">
      <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#A3907C]"></i>
      <input type="text" id="catalog-search" oninput="debouncedSearchCatalog(this.value)" placeholder="ค้นหาสินค้าที่ต้องการลอง..." class="w-full pl-10 pr-4 py-2 rounded-full bg-white/80 border border-[#A3907C]/25 text-xs focus:outline-none focus:border-[#1F2421]">
    </div>

  </div>

  <!-- Product Catalog Grid: Only "ขอลองสินค้านี้" button (No direct add to cart) -->
  <div id="catalog-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
    <% products.forEach(function(item) { %>
      <div class="product-item-card glass rounded-2xl overflow-hidden border border-[#A3907C]/20 shadow-xs hover:shadow-md transition-all flex flex-col" data-category="<%= item.ITM_Category %>" data-name="<%= item.ITM_Name.toLowerCase() %>">
        
        <!-- Image -->
        <div class="aspect-square bg-[#E8DFD1]/40 relative overflow-hidden group">
          <img src="<%= item.image || '/images/products/top-1.jpg' %>" alt="<%= item.ITM_Name %>" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
          <span class="absolute top-2.5 left-2.5 text-[10px] uppercase font-semibold px-2 py-0.5 rounded-full bg-white/80 backdrop-blur-xs text-[#1F2421]">
            <%= item.ITM_Category || 'Atelier' %>
          </span>
        </div>

        <!-- Info -->
        <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
          <div>
            <h4 class="font-medium text-xs sm:text-sm text-[#1F2421] line-clamp-1"><%= item.ITM_Name %></h4>
            <p class="font-semibold text-xs sm:text-sm text-[#1F2421] mt-1">฿<%= Number(item.ITM_Price).toLocaleString() %></p>
          </div>

          <!-- Action Button: Only Request to Try (Order one to try) -->
          <div class="mt-3 pt-3 border-t border-[#A3907C]/15">
            <button onclick="openItemRequest('<%= item.ITM_ID %>')" class="w-full btn-primary text-xs py-2.5 flex items-center justify-center gap-1.5 shadow-xs cursor-pointer">
              <i data-lucide="sparkles" class="w-3.5 h-3.5 text-[#C9A598]"></i>
              <span>สั่งมาลอง</span>
            </button>
          </div>

        </div>

      </div>
    <% }); %>
  </div>

  <!-- Sticky Bottom Bar for Mobile: Prompt Exit Fitting Room Button -->
  <div class="fixed bottom-4 left-0 right-0 max-w-lg mx-auto px-4 z-20 pointer-events-auto">
    <button onclick="confirmExitFittingRoom()" class="w-full py-3.5 px-5 rounded-2xl bg-[#1F2421] text-[#F5F2EB] font-serif font-bold text-xs sm:text-sm shadow-xl flex items-center justify-between active:scale-[0.98] transition border border-white/20 cursor-pointer">
      <div class="flex items-center gap-2">
        <i data-lucide="door-closed" class="w-4 h-4 text-[#C9A598]"></i>
        <span>ออกจากห้องลองเสื้อ (ห้อง <%= typeof roomDisplay !== 'undefined' ? roomDisplay : roomId %>)</span>
      </div>
      <span class="text-[11px] font-sans font-normal text-[#F5F2EB]/80 bg-white/10 px-2 py-0.5 rounded-full">
        เสร็จสิ้น
      </span>
    </button>
  </div>

</main>

<!-- Exit Confirmation Modal Dialog -->
<div id="exit-fitting-modal" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="w-full max-w-md glass-heavy rounded-3xl p-5 sm:p-6 shadow-2xl border border-white/80 relative animate-fade-in max-h-[90vh] flex flex-col">
    
    <!-- Modal Close X -->
    <button onclick="closeExitModal()" class="absolute top-4 right-4 p-2 rounded-full hover:bg-white/80 text-[#8A8177] hover:text-[#1F2421] transition cursor-pointer">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>

    <!-- Header -->
    <div class="text-center mb-4">
      <div class="w-12 h-12 rounded-2xl bg-[#1F2421] text-[#F5F2EB] mx-auto flex items-center justify-center mb-2 shadow-sm">
        <i data-lucide="shopping-bag" class="w-6 h-6 text-[#C9A598]"></i>
      </div>
      <h3 class="font-serif text-xl font-bold text-[#1F2421]">ออกจากห้องลองเสื้อ</h3>
      <p class="text-xs text-[#8A8177] mt-1" id="exit-modal-subtitle">
        สินค้าที่คุณสั่งมาลองและได้รับแล้ว จะนำใส่ตะกร้าสินค้าหรือไม่?
      </p>
    </div>

    <!-- Items Tried List Container -->
    <div id="exit-items-container" class="flex-1 overflow-y-auto space-y-2 mb-4 pr-1 min-h-[100px]">
      <!-- Populated via JS -->
    </div>

    <!-- Action Buttons -->
    <div class="space-y-2 pt-2 border-t border-[#A3907C]/20" id="exit-modal-actions">
      <!-- Add all & go to Checkout -->
      <button id="btn-add-and-checkout" onclick="exitAndAddToCart(true)" class="w-full btn-primary py-3 text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md cursor-pointer">
        <i data-lucide="credit-card" class="w-4 h-4"></i>
        <span>นำใส่ตะกร้า และไปชำระเงิน</span>
      </button>

      <!-- Add to Cart & return to scanner dashboard -->
      <button id="btn-add-and-return" onclick="exitAndAddToCart(false)" class="w-full btn-secondary py-2.5 text-xs flex items-center justify-center gap-2 cursor-pointer">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>นำใส่ตะกร้า และเลือกซื้อต่อ</span>
      </button>

      <!-- Leave without adding -->
      <button onclick="exitWithoutCart()" class="w-full py-2 text-xs text-[#8A8177] hover:text-red-500 transition cursor-pointer">
        ไม่นำใส่ตะกร้า (ออกจากห้องลองเลย)
      </button>

      <!-- Stay in room -->
      <button onclick="closeExitModal()" class="w-full py-1 text-[11px] text-[#A3907C] hover:underline transition cursor-pointer">
        ลองชุดต่อ
      </button>
    </div>

  </div>
</div>

<%- include('../partials/cart-drawer') %>
<%- include('../partials/request-modal', { roomId }) %>

<script>
  const catalogData = <%- JSON.stringify(products) %>;
  const currentRoomId = '<%= roomId %>';
  const currentRoomDisplay = '<%= typeof roomDisplay !== "undefined" ? roomDisplay : roomId %>';
  let serverSessionId = '<%= typeof sessionId !== "undefined" ? sessionId : "" %>';
  let currentSessionId = serverSessionId;
  const storageKey = 'crwn_active_session_' + currentRoomId;

  if (serverSessionId) {
    localStorage.setItem(storageKey, serverSessionId);
  } else {
    const stored = localStorage.getItem(storageKey);
    if (stored) currentSessionId = stored;
  }

  window.currentSessionId = currentSessionId;

  // Listen for session updates from other tabs
  window.addEventListener('storage', (e) => {
    if (e.key === storageKey && e.newValue) {
      currentSessionId = e.newValue;
      window.currentSessionId = currentSessionId;
      if (typeof refreshOrdersStatus === 'function') refreshOrdersStatus();
    }
  });

  let validCompletedOrders = [];

  function filterCategory(cat) {
    const buttons = document.querySelectorAll('.category-btn');
    buttons.forEach(b => {
      if (b.getAttribute('data-category') === cat) {
        b.className = 'category-btn px-4 py-2 rounded-full text-xs font-medium transition bg-[#1F2421] text-[#F5F2EB] shadow-xs flex-shrink-0';
      } else {
        b.className = 'category-btn px-4 py-2 rounded-full text-xs font-medium transition bg-white/70 text-[#1F2421] hover:bg-white border border-[#A3907C]/20 flex-shrink-0';
      }
    });

    const cards = document.querySelectorAll('.product-item-card');
    cards.forEach(card => {
      if (cat === 'ALL' || card.getAttribute('data-category') === cat) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function searchCatalog(query) {
    const q = query.replace(/[<>`"']/g, '').toLowerCase().trim();
    const cards = document.querySelectorAll('.product-item-card');
    cards.forEach(card => {
      const name = card.getAttribute('data-name');
      if (!q || name.includes(q)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  const debouncedSearchCatalog = typeof debounce === 'function' 
    ? debounce((val) => searchCatalog(val), 300) 
    : (val) => searchCatalog(val);

  function openItemRequest(itemId) {
    const item = catalogData.find(p => p.ITM_ID === itemId);
    if (!item) return;

    const realVariants = (item.variants && item.variants.length > 0)
      ? item.variants
      : [
          { sku: item.ITM_ID + '-s', size: 'S', color: 'Black' },
          { sku: item.ITM_ID + '-m', size: 'M', color: 'Black' },
          { sku: item.ITM_ID + '-l', size: 'L', color: 'Black' },
        ];

    const productPayload = {
      id: item.ITM_ID,
      name: item.ITM_Name,
      image: item.image || '/images/products/top-1.jpg',
      price: item.ITM_Price,
      variants: realVariants
    };
    openRequestModal(productPayload);
  }

  window.addOptimisticFittingOrder = function(order) {};
  function refreshOrdersStatus() {}

  // ==========================================================
  // Exit Fitting Room Confirmation Logic (Authoritative Server-Driven)
  // ==========================================================

  async function confirmExitFittingRoom() {
    let roomOrders = [];
    try {
      const res = await fetch(`/api/fitting-orders?roomId=${encodeURIComponent(currentRoomId)}`);
      if (res.ok) {
        roomOrders = await res.json();
      }
    } catch (e) {
      console.warn('Failed to fetch room orders:', e);
    }

    // Filter real orders
    const completedOrders = roomOrders.filter(o => String(o.status || '').toLowerCase() === 'complete');
    const undeliveredOrders = roomOrders.filter(o => String(o.status || '').toLowerCase() !== 'complete');
    validCompletedOrders = completedOrders;

    // If no orders were ever requested in this room, exit directly
    if (roomOrders.length === 0) {
      if (confirm(`คุณต้องการออกจากห้องลองเสื้อ ห้อง ${currentRoomDisplay} ใช่หรือไม่?`)) {
        await releaseCurrentRoom();
        window.location.href = '/customer/dashboard';
      }
      return;
    }

    // Render modal based on delivery status
    renderExitItemsList(completedOrders, undeliveredOrders);
    const modal = document.getElementById('exit-fitting-modal');
    modal.classList.remove('hidden');
    if (window.lucide) window.lucide.createIcons();
  }

  async function releaseCurrentRoom() {
    try {
      await fetch(`/api/fitting-rooms/${currentRoomId}/release`, { method: 'POST' });
    } catch (e) {
      console.warn('Failed to release room:', e);
    }
  }

  function renderExitItemsList(completedOrders, undeliveredOrders) {
    const container = document.getElementById('exit-items-container');
    const subtitle = document.getElementById('exit-modal-subtitle');
    const btnCheckout = document.getElementById('btn-add-and-checkout');
    const btnReturn = document.getElementById('btn-add-and-return');
    if (!container) return;

    let html = '';

    // If there are delivered items
    if (completedOrders.length > 0) {
      if (subtitle) subtitle.textContent = 'สินค้าที่พนักงานนำส่งให้แล้ว คุณต้องการนำใส่ตะกร้าสินค้าหรือไม่?';
      if (btnCheckout) btnCheckout.style.display = 'flex';
      if (btnReturn) btnReturn.style.display = 'flex';

      html += completedOrders.map(item => `
        <label class="flex items-center gap-3 p-3 rounded-2xl bg-white border border-[#A3907C]/25 shadow-2xs cursor-pointer hover:border-[#1F2421] transition">
          <input type="checkbox" name="exit-item-check" value="${item.sku}" checked class="w-4 h-4 rounded text-[#1F2421] accent-[#1F2421]">
          <img src="${item.image || '/images/products/top-1.jpg'}" alt="${item.productName || 'Item'}" loading="lazy" decoding="async" class="w-12 h-12 rounded-xl object-cover bg-[#E8DFD1] flex-shrink-0">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="block text-xs font-semibold text-[#1F2421] truncate">${item.productName}</span>
              <span class="px-1.5 py-0.2 rounded text-[9px] font-semibold bg-emerald-100 text-emerald-800">ส่งมอบแล้ว</span>
            </div>
            <span class="block text-[11px] text-[#8A8177]">ไซส์: ${item.size} · สี: ${item.color}</span>
          </div>
          <span class="text-xs font-bold text-[#1F2421] flex-shrink-0 font-mono">฿${Number(item.price).toLocaleString()}</span>
        </label>
      `).join('');
    } else {
      if (subtitle) subtitle.textContent = 'ยังไม่มีสินค้าที่พนักงานนำส่งให้ ไม่สามารถนำใส่ตะกร้าได้';
      if (btnCheckout) btnCheckout.style.display = 'none';
      if (btnReturn) btnReturn.style.display = 'none';
    }

    // If there are undelivered items (pending/preparing), display them as disabled / alert (Item 5 fix)
    if (undeliveredOrders.length > 0) {
      html += `
        <div class="p-3 rounded-2xl bg-amber-50 border border-amber-200/80 text-xs text-amber-900 space-y-2 mt-2">
          <div class="flex items-center gap-2 font-semibold">
            <i data-lucide="clock" class="w-4 h-4 text-amber-600"></i>
            <span>สินค้าที่พนักงานยังไม่ได้นำส่ง (${undeliveredOrders.length} รายการ):</span>
          </div>
          <p class="text-[11px] text-amber-800">พนักงานยังไม่ได้นำส่งสินค้าเหล่านี้มาที่ตู้เสื้อผ้า จึงไม่สามารถนำใส่ตะกร้าเพื่อนำออกนอกห้องลองได้</p>
          <div class="space-y-1.5 pt-1">
            ${undeliveredOrders.map(u => `
              <div class="flex items-center justify-between text-[11px] bg-white/70 p-2 rounded-xl border border-amber-200/60">
                <span class="truncate font-medium">${u.productName} (${u.size}/${u.color})</span>
                <span class="text-[10px] px-2 py-0.5 rounded-full ${u.status === 'preparing' ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800'} font-semibold">
                  ${u.status === 'preparing' ? 'กำลังจัดเตรียม' : 'รอดำเนินการ'}
                </span>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }

    container.innerHTML = html;
  }

  function closeExitModal() {
    document.getElementById('exit-fitting-modal')?.classList.add('hidden');
  }

  async function exitAndAddToCart(goToCheckout = false) {
    const checkedCheckboxes = document.querySelectorAll('input[name="exit-item-check"]:checked');
    const checkedSkus = Array.from(checkedCheckboxes).map(cb => cb.value);

    // Add only completed & checked items to cart
    for (const item of validCompletedOrders) {
      if (checkedSkus.includes(item.sku)) {
        await Cart.addItem({
          sku: item.sku,
          productId: item.productId,
          name: item.productName,
          price: item.price,
          color: item.color,
          size: item.size,
          image: item.image,
          quantity: 1
        }, true); // skipSync = true
      }
    }
    
    // Sync authoritative cart to backend once
    if (checkedSkus.length > 0) {
      await Cart.syncBackend();
    }

    clearTriedFittingItems(currentRoomId);
    await releaseCurrentRoom();
    closeExitModal();

    if (goToCheckout) {
      window.location.href = '/customer/checkout';
    } else {
      window.location.href = '/customer/dashboard';
    }
  }

  async function exitWithoutCart() {
    clearTriedFittingItems(currentRoomId);
    await releaseCurrentRoom();
    closeExitModal();
    window.location.href = '/customer/dashboard';
  }
</script>

<%- include('../partials/footer') %>
