<%- include('../partials/header', { title: 'ห้องลองเสื้อ Room ' + roomId + ' — crwn.st' }) %>
<%- include('../partials/navbar', { user, backAction: 'confirmExitFittingRoom()', showCart: true }) %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-4 sm:py-6 pb-28">

  <!-- Active Room Status Banner -->
  <div class="glass-heavy rounded-3xl p-4 sm:p-6 mb-6 border border-white/80 shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-[#1F2421] text-[#F5F2EB] flex items-center justify-center font-serif text-xl font-bold shadow-xs flex-shrink-0">
        <%= roomId %>
      </div>
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-[#1F2421]">ห้องลองเสื้อ <%= roomId %></h1>
      </div>
    </div>

    <!-- Right Header Action: Exit Button -->
    <div class="flex items-center gap-2">
      <button onclick="confirmExitFittingRoom()" class="btn-secondary text-xs py-2 px-4 flex items-center gap-1.5 shadow-2xs">
        <i data-lucide="log-out" class="w-4 h-4"></i>
        <span>ออกจากห้องลอง</span>
      </button>
    </div>
  </div>

  <!-- Note banner: Only order 1 item at a time to try -->
  <div class="mb-6 p-3.5 rounded-2xl bg-[#F5F2EB] border border-[#A3907C]/25 text-xs text-[#6B635A] flex items-center gap-2.5 shadow-2xs">
    <i data-lucide="info" class="w-4 h-4 text-[#A3907C] flex-shrink-0"></i>
    <span>ในห้องลองเสื้อ กรุณาสั่งสินค้ามาลองทีละตัว เมื่อลองเสร็จแล้วสามารถเลือกนำใส่ตะกร้าก่อนออกจากห้องลองได้</span>
  </div>

  <!-- Live Orders Tracking Section -->
  <div id="live-requests-section" class="mb-6 p-4 sm:p-5 rounded-2xl bg-white/90 border border-[#A3907C]/30 shadow-xs">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <i data-lucide="bell" class="w-4 h-4 text-[#A3907C]"></i>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[#1F2421]">สินค้าที่คุณสั่งมาลองในห้องนี้ (ห้อง <%= roomId %>)</h3>
      </div>
      <div class="flex items-center gap-2">
        <span id="live-requests-count" class="text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-[#F5F2EB] text-[#1F2421] border border-[#A3907C]/20">0 รายการ</span>
        <button onclick="refreshOrdersStatus()" title="รีเฟรชสถานะ" class="p-1 rounded-lg text-[#8A8177] hover:text-[#1F2421] transition">
          <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i>
        </button>
      </div>
    </div>
    
    <div id="live-requests-empty" class="p-4 rounded-xl bg-[#F5F2EB]/60 border border-dashed border-[#A3907C]/30 text-center text-xs text-[#8A8177]">
      ยังไม่มีรายการสั่งสินค้ามาลอง — เลือกไซส์/สีสินค้าที่ต้องการด้านล่างแล้วกด <strong>"สั่งมาลอง"</strong> พนักงานจะนำมาส่งให้ที่ตู้เสื้อผ้าห้องลอง
    </div>
    <div id="live-requests-list" class="space-y-2.5 hidden"></div>
  </div>

  <!-- Search & Category Filters -->
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-6">
    
    <!-- Category Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0 scrollbar-none" id="category-filter-list">
      <button onclick="filterCategory('ALL')" class="category-btn px-4 py-2 rounded-full text-xs font-medium transition bg-[#1F2421] text-[#F5F2EB] shadow-xs flex-shrink-0" data-category="ALL">
        ทั้งหมด
      </button>
      <% 
        const categories = [...new Set(products.map(p => p.ITM_Category).filter(Boolean))];
        categories.forEach(function(cat) { 
      %>
        <button onclick="filterCategory('<%= cat %>')" class="category-btn px-4 py-2 rounded-full text-xs font-medium transition bg-white/70 text-[#1F2421] hover:bg-white border border-[#A3907C]/20 flex-shrink-0" data-category="<%= cat %>">
          <%= cat %>
        </button>
      <% }); %>
    </div>

    <!-- Quick Search Input -->
    <div class="relative w-full sm:w-64">
      <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#A3907C]"></i>
      <input type="text" id="catalog-search" oninput="searchCatalog(this.value)" placeholder="ค้นหาสินค้าที่ต้องการลอง..." class="w-full pl-10 pr-4 py-2 rounded-full bg-white/80 border border-[#A3907C]/25 text-xs focus:outline-none focus:border-[#1F2421]">
    </div>

  </div>

  <!-- Product Catalog Grid: Only "ขอลองสินค้านี้" button (No direct add to cart) -->
  <div id="catalog-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
    <% products.forEach(function(item) { %>
      <div class="product-item-card glass rounded-2xl overflow-hidden border border-[#A3907C]/20 shadow-xs hover:shadow-md transition-all flex flex-col" data-category="<%= item.ITM_Category %>" data-name="<%= item.ITM_Name.toLowerCase() %>">
        
        <!-- Image -->
        <div class="aspect-square bg-[#E8DFD1]/40 relative overflow-hidden group">
          <img src="<%= item.ITM_Image || ('https://picsum.photos/seed/' + item.ITM_ID + '/600/600') %>" alt="<%= item.ITM_Name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
          <span class="absolute top-2.5 left-2.5 text-[10px] uppercase font-semibold px-2 py-0.5 rounded-full bg-white/80 backdrop-blur-xs text-[#1F2421]">
            <%= item.ITM_Category || 'Atelier' %>
          </span>
        </div>

        <!-- Info -->
        <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
          <div>
            <h4 class="font-medium text-xs sm:text-sm text-[#1F2421] line-clamp-1"><%= item.ITM_Name %></h4>
            <p class="font-semibold text-xs sm:text-sm text-[#1F2421] mt-1">฿<%= Number(item.ITM_Price).toLocaleString() %></p>
          </div>

          <!-- Action Button: Only Request to Try (Order one to try) -->
          <div class="mt-3 pt-3 border-t border-[#A3907C]/15">
            <button onclick="openItemRequest('<%= item.ITM_ID %>')" class="w-full btn-primary text-xs py-2.5 flex items-center justify-center gap-1.5 shadow-xs">
              <i data-lucide="sparkles" class="w-3.5 h-3.5 text-[#C9A598]"></i>
              <span>สั่งมาลอง</span>
            </button>
          </div>

        </div>

      </div>
    <% }); %>
  </div>

  <!-- Sticky Bottom Bar for Mobile: Prompt Exit Fitting Room Button -->
  <div class="fixed bottom-4 left-0 right-0 max-w-lg mx-auto px-4 z-20 pointer-events-auto">
    <button onclick="confirmExitFittingRoom()" class="w-full py-3.5 px-5 rounded-2xl bg-[#1F2421] text-[#F5F2EB] font-serif font-bold text-xs sm:text-sm shadow-xl flex items-center justify-between active:scale-[0.98] transition border border-white/20">
      <div class="flex items-center gap-2">
        <i data-lucide="door-closed" class="w-4 h-4 text-[#C9A598]"></i>
        <span>ออกจากห้องลองเสื้อ (Room <%= roomId %>)</span>
      </div>
      <span class="text-[11px] font-sans font-normal text-[#F5F2EB]/80 bg-white/10 px-2 py-0.5 rounded-full">
        เสร็จสิ้น
      </span>
    </button>
  </div>

</main>

<!-- Exit Confirmation Modal Dialog (Alert asking if customer wants to add tried items to cart) -->
<div id="exit-fitting-modal" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="w-full max-w-md glass-heavy rounded-3xl p-5 sm:p-6 shadow-2xl border border-white/80 relative animate-fade-in max-h-[90vh] flex flex-col">
    
    <!-- Modal Close X -->
    <button onclick="closeExitModal()" class="absolute top-4 right-4 p-2 rounded-full hover:bg-white/80 text-[#8A8177] hover:text-[#1F2421] transition">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>

    <!-- Header -->
    <div class="text-center mb-4">
      <div class="w-12 h-12 rounded-2xl bg-[#1F2421] text-[#F5F2EB] mx-auto flex items-center justify-center mb-2 shadow-sm">
        <i data-lucide="shopping-bag" class="w-6 h-6 text-[#C9A598]"></i>
      </div>
      <h3 class="font-serif text-xl font-bold text-[#1F2421]">ออกจากห้องลองเสื้อ</h3>
      <p class="text-xs text-[#8A8177] mt-1" id="exit-modal-subtitle">
        สินค้าที่คุณสั่งมาลอง จะนำใส่ตะกร้าสินค้าหรือไม่?
      </p>
    </div>

    <!-- Items Tried List Container -->
    <div id="exit-items-container" class="flex-1 overflow-y-auto space-y-2 mb-4 pr-1 min-h-[120px]">
      <!-- Populated via JS -->
    </div>

    <!-- Action Buttons -->
    <div class="space-y-2 pt-2 border-t border-[#A3907C]/20">
      <!-- Add all & go to Checkout -->
      <button id="btn-add-and-checkout" onclick="exitAndAddToCart(true)" class="w-full btn-primary py-3 text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md">
        <i data-lucide="credit-card" class="w-4 h-4"></i>
        <span>นำใส่ตะกร้า และไปชำระเงิน</span>
      </button>

      <!-- Add to Cart & return to scanner dashboard -->
      <button id="btn-add-and-return" onclick="exitAndAddToCart(false)" class="w-full btn-secondary py-2.5 text-xs flex items-center justify-center gap-2">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>นำใส่ตะกร้า และเลือกซื้อต่อ</span>
      </button>

      <!-- Leave without adding -->
      <button onclick="exitWithoutCart()" class="w-full py-2 text-xs text-[#8A8177] hover:text-red-500 transition">
        ไม่นำใส่ตะกร้า (ออกจากห้องลองเลย)
      </button>

      <!-- Stay in room -->
      <button onclick="closeExitModal()" class="w-full py-1 text-[11px] text-[#A3907C] hover:underline transition">
        ลองชุดต่อ
      </button>
    </div>

  </div>
</div>

<%- include('../partials/cart-drawer') %>
<%- include('../partials/request-modal', { roomId }) %>

<script>
  const catalogData = <%- JSON.stringify(products) %>;
  const currentRoomId = '<%= roomId %>';
  const currentSessionId = '<%= typeof sessionId !== "undefined" ? sessionId : "" %>';
  let sessionTriedItems = [];

  function filterCategory(cat) {
    const buttons = document.querySelectorAll('.category-btn');
    buttons.forEach(b => {
      if (b.getAttribute('data-category') === cat) {
        b.className = 'category-btn px-4 py-2 rounded-full text-xs font-medium transition bg-[#1F2421] text-[#F5F2EB] shadow-xs flex-shrink-0';
      } else {
        b.className = 'category-btn px-4 py-2 rounded-full text-xs font-medium transition bg-white/70 text-[#1F2421] hover:bg-white border border-[#A3907C]/20 flex-shrink-0';
      }
    });

    const cards = document.querySelectorAll('.product-item-card');
    cards.forEach(card => {
      if (cat === 'ALL' || card.getAttribute('data-category') === cat) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function searchCatalog(query) {
    const q = query.toLowerCase().trim();
    const cards = document.querySelectorAll('.product-item-card');
    cards.forEach(card => {
      const name = card.getAttribute('data-name');
      if (!q || name.includes(q)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function openItemRequest(itemId) {
    const item = catalogData.find(p => p.ITM_ID === itemId);
    if (!item) return;

    const productPayload = {
      id: item.ITM_ID,
      name: item.ITM_Name,
      image: item.ITM_Image,
      price: item.ITM_Price,
      variants: item.variants || [
        { sku: item.ITM_ID + '-s', size: 'S', color: 'Black' },
        { sku: item.ITM_ID + '-m', size: 'M', color: 'Black' },
        { sku: item.ITM_ID + '-l', size: 'L', color: 'Black' },
        { sku: item.ITM_ID + '-m-cream', size: 'M', color: 'Cream' },
      ]
    };
    openRequestModal(productPayload);
  }

  // In-memory list of customer requests in this fitting session
  let currentFittingOrders = [];

  window.addOptimisticFittingOrder = function(order) {
    if (!order) return;
    const existingIndex = currentFittingOrders.findIndex(o => o.id === order.id || (o.sku === order.sku && o.status === 'pending'));
    if (existingIndex === -1) {
      currentFittingOrders.unshift(order);
    } else {
      currentFittingOrders[existingIndex] = { ...currentFittingOrders[existingIndex], ...order };
    }
    renderCustomerRequests(currentFittingOrders);
  };

  function renderCustomerRequests(orders) {
    const emptyEl = document.getElementById('live-requests-empty');
    const listEl = document.getElementById('live-requests-list');
    const countEl = document.getElementById('live-requests-count');
    if (!listEl) return;

    if (!orders || orders.length === 0) {
      if (emptyEl) emptyEl.classList.remove('hidden');
      listEl.classList.add('hidden');
      if (countEl) countEl.textContent = '0 รายการ';
      return;
    }

    if (emptyEl) emptyEl.classList.add('hidden');
    listEl.classList.remove('hidden');
    if (countEl) countEl.textContent = `${orders.length} รายการ`;

    listEl.innerHTML = orders.map(o => {
      const status = String(o.status || 'pending').toLowerCase().trim();
      let badge = `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-900 border border-amber-200">
          <i data-lucide="clock" class="w-3 h-3 text-amber-700"></i> รอดำเนินการ
        </span>
      `;
      if (status === 'preparing') {
        badge = `
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-900 border border-blue-200 animate-pulse">
            <i data-lucide="loader-2" class="w-3 h-3 text-blue-700 animate-spin"></i> กำลังจัดเตรียม...
          </span>
        `;
      } else if (status === 'complete') {
        badge = `
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-900 border border-green-200">
            <i data-lucide="check-circle-2" class="w-3 h-3 text-green-700"></i> นำส่งที่ตู้เสื้อผ้าแล้ว ✓
          </span>
        `;
      }

      const imgHtml = o.image ? `
        <img src="${o.image}" alt="" class="w-11 h-11 rounded-xl object-cover bg-[#E8DFD1] border border-[#A3907C]/20 flex-shrink-0">
      ` : `
        <div class="w-11 h-11 rounded-xl bg-[#E8DFD1] flex items-center justify-center text-[#8A8177] flex-shrink-0">
          <i data-lucide="shirt" class="w-5 h-5"></i>
        </div>
      `;

      return `
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-xl bg-white/80 border border-[#A3907C]/20 shadow-2xs transition">
          <div class="flex items-center gap-3">
            ${imgHtml}
            <div>
              <h4 class="font-medium text-xs sm:text-sm text-[#1F2421] leading-tight">${o.productName || 'เสื้อผ้า'}</h4>
              <div class="flex items-center gap-2 mt-1 text-[11px] text-[#6B635A]">
                <span class="px-2 py-0.5 rounded bg-[#F5F2EB] font-medium text-[#1F2421]">ไซส์: ${o.size || '-'}</span>
                <span class="px-2 py-0.5 rounded bg-[#F5F2EB] font-medium text-[#1F2421]">สี: ${o.color || '-'}</span>
                <span class="text-[#8A8177] font-mono text-[10px]">ห้อง ${o.roomId || currentRoomId}</span>
              </div>
            </div>
          </div>
          <div class="flex items-center justify-end">
            ${badge}
          </div>
        </div>
      `;
    }).join('');

    if (window.lucide) window.lucide.createIcons();
  }

  // Poll orders status for this room & session
  async function refreshOrdersStatus() {
    try {
      const activeSession = currentSessionId || window.currentSessionId || '';
      const params = new URLSearchParams();
      if (currentRoomId) params.append('roomId', currentRoomId);
      if (activeSession) params.append('sessionId', activeSession);

      const res = await fetch(`/api/fitting-orders?${params.toString()}`);
      if (!res.ok) return;
      const serverOrders = await res.json();

      if (Array.isArray(serverOrders) && serverOrders.length > 0) {
        currentFittingOrders = serverOrders;
      } else if (currentFittingOrders.length === 0) {
        // Check local storage tried items fallback
        const tried = getTriedFittingItems(currentRoomId);
        if (tried && tried.length > 0) {
          currentFittingOrders = tried.map((t, idx) => ({
            id: 'local_' + idx,
            productName: t.name,
            size: t.size,
            color: t.color,
            image: t.image,
            roomId: currentRoomId,
            status: 'pending'
          }));
        }
      }

      renderCustomerRequests(currentFittingOrders);
    } catch (e) {
      console.warn('refreshOrdersStatus error:', e);
    }
  }

  // ==========================================================
  // Exit Fitting Room Confirmation Logic
  // ==========================================================

  async function confirmExitFittingRoom() {
    // Only check orders requested in THIS fitting session
    let items = [];
    try {
      const url = currentSessionId 
        ? `/api/fitting-orders?sessionId=${encodeURIComponent(currentSessionId)}` 
        : `/api/fitting-orders?roomId=${encodeURIComponent(currentRoomId)}`;
      const res = await fetch(url);
      if (res.ok) {
        const roomOrders = await res.json();
        roomOrders.forEach(ro => {
          if (!items.some(i => i.sku === ro.sku)) {
            const prod = catalogData.find(p => p.name === ro.productName || p.ITM_ID === ro.sku.split('-')[0]);
            items.push({
              sku: ro.sku,
              productId: prod ? prod.ITM_ID : ro.sku.split('-')[0],
              name: ro.productName || (prod ? prod.ITM_Name : 'เสื้อผ้า'),
              price: prod ? Number(prod.ITM_Price) : 2500,
              color: ro.color || 'Standard',
              size: ro.size || 'M',
              image: ro.image || (prod ? prod.ITM_Image : ''),
              quantity: 1
            });
          }
        });
      }
    } catch (e) {
      console.warn(e);
    }

    sessionTriedItems = items;

    // If no items were requested to try in this session, exit directly without showing modal
    // Pay & Go cart items remain isolated in Pay & Go cart
    if (sessionTriedItems.length === 0) {
      if (confirm('คุณต้องการออกจากห้องลองเสื้อ Room ' + currentRoomId + ' ใช่หรือไม่?')) {
        await releaseCurrentRoom();
        window.location.href = '/customer/dashboard';
      }
      return;
    }

    // Show Exit Modal with items requested in this session
    renderExitItemsList();
    const modal = document.getElementById('exit-fitting-modal');
    modal.classList.remove('hidden');
    if (window.lucide) window.lucide.createIcons();
  }

  async function releaseCurrentRoom() {
    try {
      await fetch(`/api/fitting-rooms/${currentRoomId}/release`, { method: 'POST' });
    } catch (e) {
      console.warn('Failed to release room:', e);
    }
  }

  function renderExitItemsList() {
    const container = document.getElementById('exit-items-container');
    if (!container) return;

    container.innerHTML = sessionTriedItems.map((item, idx) => `
      <label class="flex items-center gap-3 p-3 rounded-2xl bg-white border border-[#A3907C]/25 shadow-2xs cursor-pointer hover:border-[#1F2421] transition">
        <input type="checkbox" name="exit-item-check" value="${item.sku}" checked class="w-4 h-4 rounded text-[#1F2421] accent-[#1F2421]">
        <img src="${item.image || 'https://picsum.photos/seed/' + item.sku + '/200/200'}" class="w-12 h-12 rounded-xl object-cover bg-[#E8DFD1] flex-shrink-0">
        <div class="flex-1 min-w-0">
          <span class="block text-xs font-semibold text-[#1F2421] truncate">${item.name}</span>
          <span class="block text-[11px] text-[#8A8177]">ไซส์: ${item.size} · สี: ${item.color}</span>
        </div>
        <span class="text-xs font-bold text-[#1F2421] flex-shrink-0 font-mono">฿${Number(item.price).toLocaleString()}</span>
      </label>
    `).join('');
  }

  function closeExitModal() {
    document.getElementById('exit-fitting-modal')?.classList.add('hidden');
  }

  async function exitAndAddToCart(goToCheckout = false) {
    const checkedCheckboxes = document.querySelectorAll('input[name="exit-item-check"]:checked');
    const checkedSkus = Array.from(checkedCheckboxes).map(cb => cb.value);

    // Add selected items to cart
    for (const item of sessionTriedItems) {
      if (checkedSkus.includes(item.sku)) {
        await Cart.addItem({
          sku: item.sku,
          productId: item.productId,
          name: item.name,
          price: item.price,
          color: item.color,
          size: item.size,
          image: item.image,
          quantity: item.quantity || 1
        });
      }
    }

    clearTriedFittingItems(currentRoomId);
    await releaseCurrentRoom();
    closeExitModal();

    if (goToCheckout) {
      window.location.href = '/customer/checkout';
    } else {
      window.location.href = '/customer/dashboard';
    }
  }

  async function exitWithoutCart() {
    clearTriedFittingItems(currentRoomId);
    await releaseCurrentRoom();
    closeExitModal();
    window.location.href = '/customer/dashboard';
  }

  document.addEventListener('DOMContentLoaded', () => {
    refreshOrdersStatus();
    setInterval(refreshOrdersStatus, 5000);
  });
</script>

<%- include('../partials/footer') %>
