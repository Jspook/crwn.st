<%- include('../partials/header', { title: 'ใบเสร็จรับเงิน — crwn.st' }) %>
<%- include('../partials/navbar', { user, backUrl: '/customer/dashboard' }) %>

<main class="flex-1 max-w-md w-full mx-auto px-4 py-6 flex flex-col items-center">

  <!-- Success Notification -->
  <div class="text-center mb-5">
    <div class="w-12 h-12 rounded-full bg-black text-white mx-auto flex items-center justify-center mb-2 shadow-sm">
      <i data-lucide="check" class="w-6 h-6 stroke-[2.5]"></i>
    </div>
    <h1 class="font-serif text-2xl font-bold text-black">ชำระเงินเรียบร้อยแล้ว</h1>
    <p class="text-xs text-black/70 mt-0.5">ใบเสร็จรับเงินอิเล็กทรอนิกส์ (E-Receipt)</p>
  </div>

  <!-- High-Contrast Monochrome Receipt Paper Slip -->
  <div id="printable-receipt" class="w-full bg-white text-black border-2 border-black rounded-2xl p-6 shadow-xl relative overflow-hidden font-sans">
    
    <!-- Top Header -->
    <div class="text-center border-b-2 border-dashed border-black pb-4 mb-4">
      <h2 class="font-serif text-3xl font-black tracking-tight text-black">crwn.st</h2>
      
      <div class="mt-4 pt-3 border-t border-black/20 text-xs font-mono text-black space-y-1 text-left">
        <div class="flex justify-between">
          <span class="font-bold">RECEIPT #:</span>
          <span class="font-bold"><%= receipt.ORD_ID || receipt.id %></span>
        </div>
        <div class="flex justify-between">
          <span>DATE/TIME:</span>
          <span><%= new Date(receipt.ORD_DateTime || receipt.createdAt || Date.now()).toLocaleString('th-TH') %></span>
        </div>
        <div class="flex justify-between">
          <span>CHANNEL:</span>
          <span class="font-bold"><%= (receipt.ORD_Channel === 'customer_pay_and_go' || receipt.memberId) ? 'PAY & GO (MOBILE)' : 'POS CASHIER' %></span>
        </div>
        <div class="flex justify-between">
          <span>CUSTOMER:</span>
          <span><%= user ? user.name : 'Customer' %></span>
        </div>
      </div>
    </div>

    <!-- Line items Table -->
    <div class="space-y-3 mb-5">
      <div class="text-xs font-mono font-bold text-black flex justify-between border-b-2 border-black pb-1.5">
        <span>ITEM / DESCRIPTION</span>
        <span>AMOUNT</span>
      </div>

      <% if (receipt.items && receipt.items.length > 0) { %>
        <% receipt.items.forEach(function(item) { %>
          <div class="flex justify-between items-start text-xs font-mono">
            <div class="pr-2 flex-1">
              <span class="font-bold text-black block leading-tight"><%= item.name || item.ITM_Name || item.productName %></span>
              <span class="text-[11px] text-black/80 block mt-0.5">
                SIZE: <%= item.size || item.ITV_Size || '-' %> | COLOR: <%= item.color || item.ITV_Color || '-' %> (Qty: <%= item.quantity || item.ORD_LINE_Qty || 1 %>)
              </span>
            </div>
            <span class="font-bold text-black flex-shrink-0 text-right">
              ฿<%= ((item.price || item.ORD_LINE_UPrice || 0) * (item.quantity || item.ORD_LINE_Qty || 1)).toLocaleString(undefined, { minimumFractionDigits: 2 }) %>
            </span>
          </div>
        <% }); %>
      <% } else { %>
        <div class="text-xs text-black/60 font-mono py-2 text-center">ไม่มีรายการสินค้า</div>
      <% } %>
    </div>

    <!-- Subtotal & Grand Total -->
    <div class="border-t-2 border-dashed border-black pt-3 space-y-1.5 text-xs font-mono">
      <div class="flex justify-between">
        <span>SUBTOTAL:</span>
        <span class="font-bold">฿<%= Number(receipt.ORD_Total || receipt.total || 0).toLocaleString(undefined, { minimumFractionDigits: 2 }) %></span>
      </div>
      <div class="flex justify-between">
        <span>VAT 7% (INCLUDED):</span>
        <span>฿<%= (Number(receipt.ORD_Total || receipt.total || 0) * 7 / 107).toLocaleString(undefined, { minimumFractionDigits: 2 }) %></span>
      </div>
      
      <!-- Total Bar -->
      <div class="flex justify-between text-base font-black text-black pt-2 pb-1 border-t-2 border-black mt-2">
        <span>TOTAL:</span>
        <span class="font-mono text-xl">฿<%= Number(receipt.ORD_Total || receipt.total || 0).toLocaleString(undefined, { minimumFractionDigits: 2 }) %></span>
      </div>

      <div class="flex justify-between items-center pt-2 text-[11px]">
        <span>PAYMENT METHOD:</span>
        <span class="px-2 py-0.5 bg-black text-white font-bold uppercase rounded text-[10px]">
          <%= receipt.ORD_Method || receipt.paymentMethod || 'CREDIT CARD' %>
        </span>
      </div>
    </div>

    <!-- Barcode Graphic for Security Gate -->
    <div class="mt-6 pt-4 border-t-2 border-dashed border-black text-center font-mono">
      <div class="h-12 w-full max-w-[240px] mx-auto flex items-stretch justify-center gap-[2px] bg-white p-1">
        <!-- Stylized CSS Barcode lines -->
        <% const pattern = [2,1,3,1,2,2,1,3,1,1,2,3,2,1,1,3,2,1,2,1,3,1,2,2,1,3,1,1,2,3]; %>
        <% pattern.forEach(w => { %>
          <span class="bg-black inline-block h-full" style="width: <%= w * 2 %>px;"></span>
        <% }); %>
      </div>
      <p class="text-[11px] font-bold text-black mt-1.5 tracking-wider">
        * <%= (receipt.ORD_ID || receipt.id).toUpperCase() %> *
      </p>
      <p class="text-[10px] text-black/70 uppercase tracking-widest mt-2">
        THANK YOU
      </p>
    </div>

  </div>

  <!-- Bottom Mobile Action Buttons -->
  <div class="w-full flex gap-3 mt-6">
    <button onclick="window.print()" class="flex-1 py-3 px-4 rounded-2xl bg-white border-2 border-black text-black text-xs font-bold flex items-center justify-center gap-2 shadow-xs active:scale-[0.98] transition">
      <i data-lucide="printer" class="w-4 h-4"></i>
      <span>พิมพ์ใบเสร็จ / PDF</span>
    </button>
    <a href="/customer/dashboard" class="flex-1 py-3 px-4 rounded-2xl bg-black text-white text-xs font-bold flex items-center justify-center gap-2 shadow-md active:scale-[0.98] transition text-center">
      <i data-lucide="home" class="w-4 h-4"></i>
      <span>กลับหน้าหลัก</span>
    </a>
  </div>

</main>

<style>
  @media print {
    body * {
      visibility: hidden;
    }
    #printable-receipt, #printable-receipt * {
      visibility: visible;
    }
    #printable-receipt {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
    }
  }
</style>

<%- include('../partials/footer') %>
