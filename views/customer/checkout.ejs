<%- include('../partials/header', { title: 'ชำระเงิน Pay & Go — crwn.st' }) %>
<%- include('../partials/navbar', { user, backUrl: '/customer/dashboard' }) %>

<main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8">

  <div class="mb-6">
    <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[#1F2421]">ชำระเงิน</h1>
    <p class="text-xs sm:text-sm text-[#8A8177] mt-1">ตรวจสอบรายการสินค้าและเลือกช่องทางชำระเงิน</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Left Column: Order Items Summary (7 cols) -->
    <div class="lg:col-span-7 space-y-4">
      
      <div class="glass-heavy rounded-3xl p-6 border border-white/70 shadow-sm">
        <h3 class="font-serif text-lg font-semibold text-[#1F2421] mb-4 flex items-center justify-between">
          <span>สรุปรายการสินค้า (<span id="checkout-count">0</span> ชิ้น)</span>
          <a href="/customer/dashboard" class="text-xs text-[#A3907C] hover:underline font-sans font-normal">เลือกซื้อสินค้าเพิ่ม</a>
        </h3>

        <!-- Items list -->
        <div id="checkout-items-list" class="space-y-3 divide-y divide-[#A3907C]/15">
          <!-- Populated by JS from Cart -->
        </div>

        <!-- Empty state if cart empty -->
        <div id="checkout-empty-state" class="py-12 text-center hidden">
          <div class="w-14 h-14 rounded-full bg-[#E8DFD1]/60 mx-auto flex items-center justify-center text-[#A3907C] mb-3">
            <i data-lucide="shopping-bag" class="w-6 h-6"></i>
          </div>
          <p class="font-serif text-base text-[#1F2421]">ไม่มีสินค้าในตะกร้า</p>
          <a href="/customer/dashboard" class="btn-primary text-xs mt-3 py-2 px-4">กลับไปเลือกซื้อสินค้า</a>
        </div>

      </div>

      <!-- Secure note -->
      <div class="p-4 rounded-2xl bg-white/60 border border-[#A3907C]/20 flex items-center gap-3 text-xs text-[#6B635A]">
        <i data-lucide="shield-check" class="w-5 h-5 text-[#9BAF9F] flex-shrink-0"></i>
        <span>การชำระเงินทุกรายการผ่านการเข้ารหัสความปลอดภัยระดับธนาคาร สินค้าจะถูกปลดล็อคสัญญาณกันขโมยอัตโนมัติเมื่อชำระเงินเสร็จสิ้น</span>
      </div>

    </div>

    <!-- Right Column: Payment & Total (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      
      <div class="glass-heavy rounded-3xl p-6 border border-white/70 shadow-md">
        <h3 class="font-serif text-lg font-semibold text-[#1F2421] mb-4">ช่องทางชำระเงิน</h3>

        <!-- Payment Method Options -->
        <div class="space-y-3 mb-6">
          <label class="payment-option-card flex items-center gap-3 p-4 rounded-2xl border-2 border-[#1F2421] bg-white cursor-pointer transition shadow-xs">
            <input type="radio" name="pay-method" value="credit" checked class="sr-only" onchange="switchPaymentMethod('credit')">
            <div class="w-10 h-10 rounded-xl bg-[#E8DFD1]/60 flex items-center justify-center text-[#1F2421]">
              <i data-lucide="credit-card" class="w-5 h-5"></i>
            </div>
            <div class="flex-1">
              <span class="block text-sm font-semibold text-[#1F2421]">บัตรเครดิต / เดบิต</span>
              <span class="block text-xs text-[#8A8177]">Visa, Mastercard, JCB</span>
            </div>
            <i data-lucide="check-circle" class="w-5 h-5 text-[#1F2421]"></i>
          </label>

          <label class="payment-option-card flex items-center gap-3 p-4 rounded-2xl border border-[#A3907C]/25 bg-white/70 hover:bg-white cursor-pointer transition shadow-xs">
            <input type="radio" name="pay-method" value="qr" class="sr-only" onchange="switchPaymentMethod('qr')">
            <div class="w-10 h-10 rounded-xl bg-[#E8DFD1]/60 flex items-center justify-center text-[#1F2421]">
              <i data-lucide="qr-code" class="w-5 h-5"></i>
            </div>
            <div class="flex-1">
              <span class="block text-sm font-semibold text-[#1F2421]">Thai QR PromptPay</span>
              <span class="block text-xs text-[#8A8177]">สแกนจ่ายผ่าน Mobile Banking</span>
            </div>
            <i data-lucide="circle" class="w-5 h-5 text-[#8A8177]"></i>
          </label>
        </div>

        <!-- Dynamic Payment Details -->
        <div id="payment-view-credit" class="p-4 rounded-2xl bg-white/80 border border-[#A3907C]/20 mb-6 space-y-3 text-xs">
          <div>
            <label class="block text-[#8A8177] mb-1 font-medium">หมายเลขบัตร</label>
            <input type="text" value="•••• •••• •••• 4242" readonly class="w-full px-3 py-2 rounded-xl bg-[#F5F2EB] border border-[#A3907C]/25 font-mono text-[#1F2421]">
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[#8A8177] mb-1 font-medium">หมดอายุ</label>
              <input type="text" value="12/28" readonly class="w-full px-3 py-2 rounded-xl bg-[#F5F2EB] border border-[#A3907C]/25 font-mono text-[#1F2421]">
            </div>
            <div>
              <label class="block text-[#8A8177] mb-1 font-medium">CVV</label>
              <input type="password" value="888" readonly class="w-full px-3 py-2 rounded-xl bg-[#F5F2EB] border border-[#A3907C]/25 font-mono text-[#1F2421]">
            </div>
          </div>
        </div>

        <div id="payment-view-qr" class="p-5 rounded-2xl bg-white/80 border border-[#A3907C]/20 mb-6 text-center hidden">
          <p class="text-xs text-[#8A8177] mb-3">สแกน QR ผ่านแอปธนาคารใดก็ได้</p>
          <div class="w-40 h-40 mx-auto bg-white p-2 rounded-2xl border border-[#A3907C]/30 shadow-xs flex items-center justify-center">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=CRWN_ST_PROMPTPAY_PAYMENT" alt="PromptPay QR" class="w-full h-full object-contain">
          </div>
          <p class="text-[11px] text-[#A3907C] font-mono mt-2">Biller ID: 0105558000001</p>
        </div>

        <!-- Price Breakdown -->
        <div class="border-t border-[#A3907C]/15 pt-4 space-y-2 text-xs">
          <div class="flex justify-between text-[#8A8177]">
            <span>ราคาสินค้ารวม (Subtotal)</span>
            <span id="summary-subtotal" class="font-medium text-[#1F2421]">฿0.00</span>
          </div>
          <div class="flex justify-between text-[#8A8177]">
            <span>ภาษีมูลค่าเพิ่ม (VAT 7% รวมแล้ว)</span>
            <span class="font-medium text-[#1F2421]">รวมในราคาแล้ว</span>
          </div>
          <div class="flex justify-between text-sm font-semibold text-[#1F2421] pt-2 border-t border-[#A3907C]/10">
            <span>ยอดชำระสุทธิ (Total)</span>
            <span id="summary-total" class="font-serif text-xl font-bold text-[#1F2421]">฿0.00</span>
          </div>
        </div>

        <!-- Submit Button -->
        <button onclick="processCheckout()" id="btn-submit-payment" class="w-full btn-primary py-4 text-sm mt-6 shadow-lg">
          <span id="btn-submit-text">ยืนยันและชำระเงิน</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </button>

      </div>

    </div>

  </div>

</main>

<script>
  let selectedMethod = 'credit';

  function renderCheckoutPage() {
    const list = document.getElementById('checkout-items-list');
    const emptyState = document.getElementById('checkout-empty-state');
    const countEl = document.getElementById('checkout-count');
    const subtotalEl = document.getElementById('summary-subtotal');
    const totalEl = document.getElementById('summary-total');
    const btn = document.getElementById('btn-submit-payment');

    if (!list) return;

    if (Cart.items.length === 0) {
      list.innerHTML = '';
      emptyState.classList.remove('hidden');
      if (btn) btn.disabled = true;
      if (countEl) countEl.textContent = '0';
      if (subtotalEl) subtotalEl.textContent = '฿0.00';
      if (totalEl) totalEl.textContent = '฿0.00';
      return;
    }

    emptyState.classList.add('hidden');
    if (btn) btn.disabled = false;
    countEl.textContent = Cart.getCount();

    const formattedTotal = '฿' + Cart.getTotal().toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    subtotalEl.textContent = formattedTotal;
    totalEl.textContent = formattedTotal;

    list.innerHTML = Cart.items.map(item => `
      <div class="flex items-center gap-4 py-3 first:pt-0">
        <div class="w-16 h-16 rounded-xl bg-[#E8DFD1]/50 overflow-hidden flex-shrink-0">
          <img src="${item.image || 'https://picsum.photos/seed/' + item.sku + '/200/200'}" alt="${item.name}" class="w-full h-full object-cover">
        </div>
        <div class="flex-1 min-w-0">
          <h4 class="font-medium text-sm text-[#1F2421] truncate">${item.name}</h4>
          <p class="text-xs text-[#8A8177] mt-0.5">ไซส์: ${item.size} · สี: ${item.color}</p>
          <span class="text-xs font-semibold text-[#1F2421]">฿${Number(item.price).toLocaleString()} × ${item.quantity}</span>
        </div>
        <div class="text-right">
          <span class="font-medium text-sm text-[#1F2421]">฿${(item.price * item.quantity).toLocaleString()}</span>
        </div>
      </div>
    `).join('');

    if (window.lucide) window.lucide.createIcons();
  }

  function switchPaymentMethod(method) {
    selectedMethod = method;
    const creditView = document.getElementById('payment-view-credit');
    const qrView = document.getElementById('payment-view-qr');
    const cards = document.querySelectorAll('.payment-option-card');

    if (method === 'credit') {
      creditView.classList.remove('hidden');
      qrView.classList.add('hidden');
      cards[0].className = 'payment-option-card flex items-center gap-3 p-4 rounded-2xl border-2 border-[#1F2421] bg-white cursor-pointer transition shadow-xs';
      cards[1].className = 'payment-option-card flex items-center gap-3 p-4 rounded-2xl border border-[#A3907C]/25 bg-white/70 hover:bg-white cursor-pointer transition shadow-xs';
    } else {
      creditView.classList.add('hidden');
      qrView.classList.remove('hidden');
      cards[0].className = 'payment-option-card flex items-center gap-3 p-4 rounded-2xl border border-[#A3907C]/25 bg-white/70 hover:bg-white cursor-pointer transition shadow-xs';
      cards[1].className = 'payment-option-card flex items-center gap-3 p-4 rounded-2xl border-2 border-[#1F2421] bg-white cursor-pointer transition shadow-xs';
    }
  }

  async function processCheckout() {
    if (Cart.items.length === 0) return;

    const btn = document.getElementById('btn-submit-payment');
    const text = document.getElementById('btn-submit-text');
    btn.disabled = true;
    text.textContent = 'กำลังประมวลผลการชำระเงิน...';

    try {
      const res = await fetch('/api/receipts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paymentMethod: selectedMethod,
          items: Cart.items.map(i => ({
            sku: i.sku,
            productId: i.productId,
            name: i.name,
            color: i.color,
            size: i.size,
            price: i.price,
            quantity: i.quantity
          })),
          total: Cart.getTotal()
        })
      });

      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error || 'เกิดข้อผิดพลาดในการทำรายการ');
      }

      const orderReceipt = await res.json();
      await Cart.clear();
      window.location.href = `/customer/receipt/${orderReceipt.id}`;
    } catch (err) {
      alert(err.message);
      btn.disabled = false;
      text.textContent = 'ยืนยันและชำระเงิน';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderCheckoutPage();
  });

  window.addEventListener('crwn:cart-updated', () => {
    renderCheckoutPage();
  });
</script>

<%- include('../partials/footer') %>
